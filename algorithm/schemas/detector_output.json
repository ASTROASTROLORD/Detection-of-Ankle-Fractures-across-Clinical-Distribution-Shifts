{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detector output",
  "type": "object",
  "required": ["image_id", "detections"],
  "properties": {
    "image_id": {"type": "string"},
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "score", "box"],
        "properties": {
          "label": {"type": "integer", "minimum": 0, "maximum": 3},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "box": {"type": "array", "minItems": 4, "maxItems": 4}
        }
      }
    }
  }
}
