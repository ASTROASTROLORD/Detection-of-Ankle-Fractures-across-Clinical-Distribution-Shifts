{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patient input",
  "type": "object",
  "required": ["patient_id", "images"],
  "properties": {
    "patient_id": {"type": "string", "minLength": 1},
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["image_id", "detections"],
        "properties": {
          "image_id": {"type": "string", "minLength": 1},
          "detections": {"type": "array"}
        }
      }
    },
    "ground_truth_by_class": {
      "type": "object",
      "description": "Optional reference boxes grouped by detector class index.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["box"],
          "properties": {
            "box": {"type": "array", "minItems": 4, "maxItems": 4}
          }
        }
      }
    }
  }
}
