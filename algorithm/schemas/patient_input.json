{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patient input",
  "type": "object",
  "required": [
    "patient_id"
  ],
  "oneOf": [
    {
      "required": [
        "images"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "image_ids"
            ]
          },
          {
            "required": [
              "detections"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "image_ids"
      ],
      "not": {
        "required": [
          "images"
        ]
      }
    }
  ],
  "properties": {
    "patient_id": {
      "type": "string",
      "minLength": 1
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "image_id",
          "detections"
        ],
        "properties": {
          "image_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scene": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "ground_truth": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "gt_id",
                "label",
                "box"
              ],
              "properties": {
                "gt_id": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "label": {
                  "$ref": "#/$defs/label"
                },
                "box": {
                  "$ref": "#/$defs/box"
                }
              }
            }
          },
          "detections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "score",
                "box"
              ],
              "properties": {
                "label": {
                  "$ref": "#/$defs/label"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "box": {
                  "$ref": "#/$defs/box"
                }
              }
            }
          }
        }
      }
    },
    "image_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "image_id",
          "label",
          "score",
          "box"
        ],
        "properties": {
          "image_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "box": {
            "$ref": "#/$defs/box"
          }
        }
      }
    },
    "target_labels_by_image": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/label"
        }
      }
    },
    "ground_truth_by_image": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "gt_id",
            "label",
            "box"
          ],
          "properties": {
            "gt_id": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "label": {
              "$ref": "#/$defs/label"
            },
            "box": {
              "$ref": "#/$defs/box"
            }
          }
        }
      }
    },
    "ground_truth_by_class": {
      "type": "object",
      "description": "Single-image compatibility format. Use ground_truth_by_image for multiple images.",
      "propertyNames": {
        "enum": [
          "0",
          "1",
          "2",
          "3"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "box"
          ],
          "properties": {
            "box": {
              "$ref": "#/$defs/box"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "box": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    }
  }
}
